diff --git a/frontend/style.css b/frontend/style.css
index 38ccaf3..6813272 100644
--- a/frontend/style.css
+++ b/frontend/style.css
@@ -2326,6 +2326,91 @@ body.comparison-report .sidebar-footer {
 }
 
 /* Supplementary EXIF/C2PA comparison, separate from the hardened verdict. */
+
+/* Transparent provenance score gauge. The needle angle is supplied by app.js. */
+.trust-gauge {
+    --trust-angle: -180deg;
+    position: relative;
+    width: min(100%, 320px);
+    aspect-ratio: 2 / 1.12;
+    margin: 1rem auto .8rem;
+    overflow: hidden;
+}
+
+.trust-gauge-dial {
+    position: absolute;
+    inset: 0 0 auto;
+    aspect-ratio: 1;
+    border-radius: 50%;
+    background: conic-gradient(
+        from 270deg,
+        #ef2b21 0deg,
+        #ff6a1a 45deg,
+        #e6cf16 90deg,
+        #73d21f 135deg,
+        #00d957 180deg,
+        transparent 180deg
+    );
+    box-shadow: 0 0 26px rgba(0, 217, 87, .12), inset 0 0 18px rgba(255, 255, 255, .12);
+}
+
+.trust-gauge-dial::after {
+    content: "";
+    position: absolute;
+    inset: 23%;
+    border-radius: 50%;
+    background: #071018;
+    box-shadow: inset 0 0 24px rgba(0, 229, 255, .08);
+}
+
+.trust-gauge-needle {
+    position: absolute;
+    z-index: 2;
+    left: 50%;
+    bottom: 10.5%;
+    width: 40%;
+    height: 4px;
+    border-radius: 999px;
+    transform-origin: 0 50%;
+    transform: rotate(var(--trust-angle));
+    background: linear-gradient(90deg, #f7fbff 0%, #9eabb5 68%, #53616c 100%);
+    box-shadow: 0 0 8px rgba(226, 244, 255, .7);
+    transition: transform .85s cubic-bezier(.2, .8, .2, 1);
+}
+
+.trust-gauge-hub {
+    position: absolute;
+    z-index: 3;
+    left: 50%;
+    bottom: 10.5%;
+    width: 22px;
+    height: 22px;
+    border: 2px solid #dbe7ef;
+    border-radius: 50%;
+    transform: translate(-50%, 50%);
+    background: radial-gradient(circle at 35% 30%, #d9e0e5, #56626b 70%);
+    box-shadow: 0 0 12px rgba(221, 241, 255, .55);
+}
+
+.trust-gauge-edge {
+    position: absolute;
+    z-index: 4;
+    bottom: 0;
+    font: 700 .72rem/1 var(--font-mono, monospace);
+    letter-spacing: .08em;
+}
+
+.trust-gauge-low { left: 1%; color: #ff5a45; }
+.trust-gauge-high { right: 1%; color: #29e777; }
+
+.trust-gauge-unavailable {
+    filter: saturate(.25);
+    opacity: .58;
+}
+
+@media (prefers-reduced-motion: reduce) {
+    .trust-gauge-needle { transition: none; }
+}
 .exif-panel { grid-column: 1 / -1; }
 .exif-comparison-list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.9rem; }
 .exif-comparison-row { min-width: 0; padding: 1rem; border: 1px solid var(--border-subtle); border-radius: 10px; background: rgba(6, 13, 24, 0.86); }
diff --git a/tests/frontend_interaction.cjs b/tests/frontend_interaction.cjs
index 8b8e67c..8b1ce6e 100644
--- a/tests/frontend_interaction.cjs
+++ b/tests/frontend_interaction.cjs
@@ -22,11 +22,15 @@ class Element {
     constructor(attrs = '') {
         this.attrs = Object.fromEntries([...attrs.matchAll(/([\w-]+)="([^"]*)"/g)].map(m => [m[1], m[2]]));
         this.className = this.attrs.class || '';
-        this.textContent = ''; this.style = {}; this.events = {}; this.files = [];
+        this.textContent = ''; this.style = {setProperty: (name, value) => { this.style[name] = value; }}; this.events = {}; this.files = [];
         this.classList = {
             contains: value => this.className.split(/\s+/).includes(value),
             add: (...values) => { this.className += ' ' + values.join(' '); },
-            remove: (...values) => { this.className = this.className.split(/\s+/).filter(v => !values.includes(v)).join(' '); }
+            remove: (...values) => { this.className = this.className.split(/\s+/).filter(v => !values.includes(v)).join(' '); },
+            toggle: (value, force) => {
+                const shouldAdd = force === undefined ? !this.className.split(/\s+/).includes(value) : force;
+                if (shouldAdd) this.classList.add(value); else this.classList.remove(value);
+            }
         };
     }
     addEventListener(name, fn) { this.events[name] = fn; }
